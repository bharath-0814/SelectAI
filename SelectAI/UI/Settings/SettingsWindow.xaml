<Window x:Class="SelectAI.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelectAI Settings"
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#181B22"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Tabbed Settings Content -->
            <RowDefinition Height="Auto" /> <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Border Background="#0284C7" Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                    <Path Data="M10,0 L12.5,7.5 L20,10 L12.5,12.5 L10,20 L7.5,12.5 L0,10 L7.5,7.5 Z"
                          Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SelectAI Settings" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Customize screen selection behavior, hotkeys, and AI intelligence providers."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="38,4,0,0" />
        </StackPanel>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- GENERAL TAB -->
            <TabItem Header="⚙️ General" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13">
                <Border Background="#1E212A" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,10,0,0">
                    <StackPanel Orientation="Vertical">
                        <!-- Auto Start -->
                        <CheckBox x:Name="ChkStartWithWindows" Content="Launch SelectAI automatically when Windows starts"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,16" />

                        <!-- Default Selection Mode -->
                        <TextBlock Text="Default Selection Mode" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbDefaultMode" Width="240" HorizontalAlignment="Left" Margin="0,0,0,16"
                                  Background="#14161E" Foreground="White" Padding="8,4">
                            <ComboBoxItem Content="〰️ Freeform (Circle / Trace)" IsSelected="True" />
                            <ComboBoxItem Content="🔲 Rectangle" />
                            <ComboBoxItem Content="📝 Text (Auto-OCR)" />
                            <ComboBoxItem Content="🖼️ Image" />
                        </ComboBox>

                        <!-- Auto-copy OCR -->
                        <CheckBox x:Name="ChkAutoCopyOcr" Content="Automatically copy recognized text to clipboard upon selection"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,16" />

                        <!-- Glow Animation Toggle -->
                        <CheckBox x:Name="ChkGlowAnimation" Content="Enable neon glow trailing animation when drawing"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" IsChecked="True" Margin="0,0,0,16" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- SHORTCUT TAB -->
            <TabItem Header="⌨️ Shortcut" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13">
                <Border Background="#1E212A" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,10,0,0">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Global Activation Hotkey" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                        <TextBlock Text="Press this hotkey anywhere in Windows to freeze the screen and start selecting."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                        <!-- Modifiers -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <CheckBox x:Name="ChkCtrl" Content="Ctrl" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" />
                            <CheckBox x:Name="ChkShift" Content="Shift" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" />
                            <CheckBox x:Name="ChkAlt" Content="Alt" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" />
                            <CheckBox x:Name="ChkWin" Content="Windows" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" />
                        </StackPanel>

                        <!-- Key Picker -->
                        <TextBlock Text="Key:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbHotkeyKey" Width="180" HorizontalAlignment="Left" Background="#14161E" Foreground="White" Padding="8,4" Margin="0,0,0,16">
                            <ComboBoxItem Content="Space" IsSelected="True" />
                            <ComboBoxItem Content="A" />
                            <ComboBoxItem Content="S" />
                            <ComboBoxItem Content="Q" />
                            <ComboBoxItem Content="X" />
                            <ComboBoxItem Content="F1" />
                            <ComboBoxItem Content="F2" />
                            <ComboBoxItem Content="F4" />
                            <ComboBoxItem Content="F9" />
                            <ComboBoxItem Content="PrintScreen" />
                        </ComboBox>

                        <!-- Feedback -->
                        <TextBlock x:Name="TxtHotkeyStatus" Text="Default: Ctrl + Shift + Space" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- AI CONFIGURATION TAB -->
            <TabItem Header="✨ AI Provider" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13">
                <Border Background="#1E212A" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,10,0,0">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Active AI Engine" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbAiProvider" Width="280" HorizontalAlignment="Left" Margin="0,0,0,16"
                                  Background="#14161E" Foreground="White" Padding="8,4" SelectionChanged="OnAiProviderSelectionChanged">
                            <ComboBoxItem Content="SelectAI Built-in Assistant (No key needed)" IsSelected="True" />
                            <ComboBoxItem Content="Google Gemini (Recommended)" />
                            <ComboBoxItem Content="OpenAI (ChatGPT)" />
                        </ComboBox>

                        <!-- Gemini Options -->
                        <StackPanel x:Name="PnlGeminiSettings" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Gemini Model:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbGeminiModel" Width="240" HorizontalAlignment="Left" Background="#14161E" Foreground="White" Margin="0,0,0,10">
                                <ComboBoxItem Content="gemini-2.0-flash" IsSelected="True" />
                                <ComboBoxItem Content="gemini-1.5-flash" />
                                <ComboBoxItem Content="gemini-1.5-pro" />
                            </ComboBox>

                            <TextBlock Text="Gemini API Key:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="TxtGeminiApiKey" Width="380" HorizontalAlignment="Left" Background="#14161E" Foreground="White" Padding="8,6" Margin="0,0,0,6" />
                            <TextBlock Text="Your key is stored securely using Windows DPAPI encryption." FontSize="11" Foreground="#38BDF8" />
                        </StackPanel>

                        <!-- OpenAI Options -->
                        <StackPanel x:Name="PnlOpenAiSettings" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="OpenAI Model:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbOpenAiModel" Width="240" HorizontalAlignment="Left" Background="#14161E" Foreground="White" Margin="0,0,0,10">
                                <ComboBoxItem Content="gpt-4o-mini" IsSelected="True" />
                                <ComboBoxItem Content="gpt-4o" />
                            </ComboBox>

                            <TextBlock Text="OpenAI API Key:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="TxtOpenAiApiKey" Width="380" HorizontalAlignment="Left" Background="#14161E" Foreground="White" Padding="8,6" Margin="0,0,0,6" />
                            <TextBlock Text="Your key is stored securely using Windows DPAPI encryption." FontSize="11" Foreground="#38BDF8" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- SEARCH & OCR TAB -->
            <TabItem Header="🔍 Search &amp; OCR" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13">
                <Border Background="#1E212A" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,10,0,0">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Search Engine" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                        <TextBlock Text="Google is the default search engine (uses your default system browser)."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14" />

                        <TextBlock Text="OCR Engine" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                        <TextBlock Text="Using Windows Native OCR (offline, private, hardware-accelerated)."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14" />

                        <!-- Privacy notice -->
                        <Border Background="#162032" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="🔒 Privacy &amp; Local Processing Guarantee" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4" />
                                <TextBlock Text="Screen captures and OCR processing are executed 100% locally on your PC. No screenshots or data are uploaded anywhere unless you explicitly click 'Ask AI' or 'Search'."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="TxtSaveFeedback" Text="" Foreground="{StaticResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset Defaults" Style="{StaticResource ToolbarActionButton}" Margin="0,0,8,0" Click="OnResetClick" />
                <Button Content="Save &amp; Apply" Style="{StaticResource ToolbarPrimaryButton}" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
