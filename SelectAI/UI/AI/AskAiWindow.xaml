<UserControl x:Class="SelectAI.UI.AI.AskAiWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="420" MaxHeight="520">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource SurfaceBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14"
            Effect="{StaticResource ElevationShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Prompt Chips -->
                <RowDefinition Height="Auto" /> <!-- Prompt Input Box -->
                <RowDefinition Height="*" />    <!-- Response Area -->
                <RowDefinition Height="Auto" /> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M10,0 L12.5,7.5 L20,10 L12.5,12.5 L10,20 L7.5,12.5 L0,10 L7.5,7.5 Z"
                          Fill="{StaticResource AccentBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,8,0" />
                    <TextBlock Text="Ask AI" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Provider Badge -->
                <Border Grid.Column="1" Background="#262D3D" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtProviderName" Text="Gemini 2.0" FontSize="11" Foreground="#38BDF8" FontWeight="Medium" />
                </Border>

                <!-- Close Button -->
                <Button Grid.Column="2" Style="{StaticResource ToolbarActionButton}" Width="28" Height="28" Padding="0" Click="OnCloseClick">
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                          Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Prompt Quick Chips -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <Button Content="💡 Explain this" Style="{StaticResource ToolbarActionButton}" Background="#252A36" Margin="0,0,6,6" Padding="8,4" FontSize="11" Click="OnQuickChipClick" />
                <Button Content="📋 Summarize" Style="{StaticResource ToolbarActionButton}" Background="#252A36" Margin="0,0,6,6" Padding="8,4" FontSize="11" Click="OnQuickChipClick" />
                <Button Content="⚡ Debug code" Style="{StaticResource ToolbarActionButton}" Background="#252A36" Margin="0,0,6,6" Padding="8,4" FontSize="11" Click="OnQuickChipClick" />
                <Button Content="🌐 Translate" Style="{StaticResource ToolbarActionButton}" Background="#252A36" Margin="0,0,6,6" Padding="8,4" FontSize="11" Click="OnQuickChipClick" />
            </WrapPanel>

            <!-- Prompt Input Box -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtPromptInput"
                         Background="#14161D"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource SurfaceBorderBrush}"
                         BorderThickness="1"
                         Padding="10,8"
                         FontSize="12"
                         Height="36"
                         VerticalContentAlignment="Center"
                         KeyDown="OnPromptKeyDown" />

                <!-- Submit Button -->
                <Button Grid.Column="1"
                        x:Name="BtnSendPrompt"
                        Style="{StaticResource ToolbarPrimaryButton}"
                        Margin="6,0,0,0"
                        Width="36" Height="36"
                        Padding="0"
                        Click="OnSendClick">
                    <!-- Send Arrow Icon -->
                    <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                          Fill="#0F172A"
                          Width="13" Height="13"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Response Viewer Area -->
            <Border Grid.Row="3"
                    Background="#14161E"
                    BorderBrush="#2A2F3D"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    MinHeight="120"
                    MaxHeight="260">
                <Grid>
                    <!-- Loading Indicator -->
                    <StackPanel x:Name="PnlLoading" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Thinking..." Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <ProgressBar IsIndeterminate="True" Width="140" Height="4" Foreground="{StaticResource AccentBrush}" Background="#252A38" BorderThickness="0" />
                    </StackPanel>

                    <!-- Response Text ScrollViewer -->
                    <ScrollViewer x:Name="ScrollResponse" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="TxtResponseContent"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   LineHeight="18"
                                   Text="Ask a question or tap a chip above to analyze your screen selection." />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Footer Action Row -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCopyResponse"
                            Style="{StaticResource ToolbarActionButton}"
                            Content="Copy Answer"
                            FontSize="11"
                            Padding="8,4"
                            Height="28"
                            Margin="4,0,0,0"
                            Click="OnCopyResponseClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
