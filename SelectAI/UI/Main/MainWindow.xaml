<Window x:Class="SelectAI.UI.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelectAI — Screen Selection &amp; AI Intelligence"
        Height="580" Width="820"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E18"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="../../Assets/app_icon.ico"
        ShowInTaskbar="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Hero Banner -->
            <RowDefinition Height="*" />    <!-- Feature Cards Grid -->
            <RowDefinition Height="Auto" /> <!-- Footer Controls -->
        </Grid.RowDefinitions>

        <!-- 1. Header with Logo & Live Status -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0" Background="#161B28" BorderBrush="#00F0FF" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Color="#00F0FF" Opacity="0.5" ShadowDepth="0" />
                    </Border.Effect>
                    <Image Source="../../Assets/app_icon.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SelectAI" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0" />
                        <Border Background="#1E293B" CornerRadius="6" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                        </Border>
                        <!-- Active Status Pill -->
                        <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Ready &amp; Listening" FontSize="11" FontWeight="Bold" Foreground="#A7F3D0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Galaxy AI Selection Intelligence • Windows 11 Desktop Utility"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Header Quick Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⚙️ Settings" Style="{StaticResource ToolbarActionButton}" Height="36" Padding="14,0" Margin="0,0,8,0" Click="OnSettingsClick" />
                <Button Content="— Minimize" Style="{StaticResource ToolbarActionButton}" Height="36" Padding="12,0" Margin="0,0,8,0" Click="OnMinimizeClick" />
            </StackPanel>
        </Grid>

        <!-- 2. Hero Action Banner -->
        <Border Grid.Row="1" Margin="0,0,0,20" CornerRadius="16" Padding="24,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#101726" Offset="0" />
                    <GradientStop Color="#152038" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00F0FF" Offset="0" />
                    <GradientStop Color="#C084FC" Offset="0.5" />
                    <GradientStop Color="#3B82F6" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1.5</Border.BorderThickness>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#00F0FF" Opacity="0.25" ShadowDepth="2" Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Freeze Screen &amp; Circle Anything" FontSize="18" FontWeight="ExtraBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                    <TextBlock Text="Press the global shortcut anywhere on Windows, or click the button on the right to start."
                               FontSize="13" Foreground="#94A3B8" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Shortcuts: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                        <Border Background="#1E293B" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtHotkeyDisplay" Text="Ctrl + Shift + C" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" />
                        </Border>
                        <Border Background="#1E293B" BorderBrush="#A78BFA" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                            <TextBlock Text="Ctrl + Shift + S" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" />
                        </Border>
                        <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,2">
                            <TextBlock Text="Ctrl + Shift + Space" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Huge Start Selection Button -->
                <Button Grid.Column="1" Height="50" Padding="24,0" Cursor="Hand" Click="OnStartSelectionClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00F0FF" Offset="0" />
                                        <GradientStop Color="#3B82F6" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" Color="#00F0FF" Opacity="0.6" ShadowDepth="0" />
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✨" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Start Selection Now" FontSize="15" FontWeight="Bold" Foreground="#07090E" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 3. Quick Feature Cards Grid (4 Cards) -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Freeform Tracing -->
            <Border Grid.Row="0" Grid.Column="0" Background="#121722" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="〰️" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Freeform Circle Tracing" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Draw organic loops and circular selections around any element on your screen with real-time spline smoothing and neon trailing."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Button Grid.Row="2" Content="Start Freeform" Style="{StaticResource ToolbarActionButton}" Height="30" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnStartFreeformClick" />
                </Grid>
            </Border>

            <!-- Card 2: Rectangle Cutout -->
            <Border Grid.Row="0" Grid.Column="1" Background="#121722" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔲" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Precision Rectangle" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Select sharp rectangular areas to grab precise screenshots, copy tables, or crop UI dialogs without background distraction."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Button Grid.Row="2" Content="Start Rectangle" Style="{StaticResource ToolbarActionButton}" Height="30" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnStartRectangleClick" />
                </Grid>
            </Border>

            <!-- Card 3: Multimodal AI Intelligence -->
            <Border Grid.Row="1" Grid.Column="0" Background="#121722" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,8,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🤖" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Multimodal Ask AI" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Send visual selections directly to Google Gemini 2.0 Flash or OpenAI GPT-4o for code debugging, translation, and explanations."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Button Grid.Row="2" Content="Configure AI Provider" Style="{StaticResource ToolbarActionButton}" Height="30" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnSettingsClick" />
                </Grid>
            </Border>

            <!-- Card 4: Google Lens & Search -->
            <Border Grid.Row="1" Grid.Column="1" Background="#121722" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔍" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Google Lens &amp; Offline OCR" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Extract text instantly using Windows native offline OCR. Perform reverse visual searches on Google Lens in your default browser."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Button Grid.Row="2" Content="Configure Search" Style="{StaticResource ToolbarActionButton}" Height="30" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnSettingsClick" />
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Footer Controls -->
        <Border Grid.Row="3" Background="#10141E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Auto-start toggle -->
                    <CheckBox x:Name="ChkAutoStart" Content="Start with Windows" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged" />

                    <!-- Desktop Shortcut status -->
                    <Border Background="#1E293B" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥️ Desktop App Ready" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer Right Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Keep on Taskbar (Minimize)" Style="{StaticResource ToolbarActionButton}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="OnMinimizeClick" ToolTip="Minimize SelectAI to your Windows Taskbar" />
                    <Button Content="Exit SelectAI" Style="{StaticResource ToolbarActionButton}" Height="32" Padding="12,0" Foreground="#F87171" Click="OnExitClick" ToolTip="Completely close SelectAI" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
