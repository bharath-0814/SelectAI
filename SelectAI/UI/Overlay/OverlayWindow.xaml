<Window x:Class="SelectAI.UI.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:SelectAI.UI.Overlay"
        xmlns:ai="clr-namespace:SelectAI.UI.AI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        KeyDown="OnWindowKeyDown"
        Focusable="True"
        Cursor="Cross">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- Layer 1: Frozen Desktop Background -->
        <Image x:Name="ImgFrozenBackground" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Layer 2: Interactive High-Speed Selection Canvas -->
        <overlay:SelectionCanvas x:Name="OverlayCanvas"
                                 MouseDown="OnCanvasMouseDown"
                                 MouseMove="OnCanvasMouseMove"
                                 MouseUp="OnCanvasMouseUp" />

        <!-- Layer 3: Top Mode Switcher Capsule -->
        <Border x:Name="ModeBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Background="#D9161922"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="6,4"
                Effect="{StaticResource SubtleShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="RbFreeform" Content="〰️ Freeform" Style="{StaticResource ModePillButton}" IsChecked="True" Checked="OnModeChanged" ToolTip="Circle or trace around anything (Key: 1)" />
                <RadioButton x:Name="RbRectangle" Content="🔲 Rectangle" Style="{StaticResource ModePillButton}" Margin="4,0,0,0" Checked="OnModeChanged" ToolTip="Select rectangular region (Key: 2)" />
                <RadioButton x:Name="RbText" Content="📝 Text" Style="{StaticResource ModePillButton}" Margin="4,0,0,0" Checked="OnModeChanged" ToolTip="Select text for OCR (Key: 3)" />
                <RadioButton x:Name="RbImage" Content="🖼️ Image" Style="{StaticResource ModePillButton}" Margin="4,0,0,0" Checked="OnModeChanged" ToolTip="Select image region (Key: 4)" />

                <!-- Hint Divider -->
                <Rectangle Width="1" Height="16" Fill="{StaticResource SurfaceBorderBrush}" Margin="8,0" />

                <!-- ESC Hint -->
                <TextBlock Text="Esc to exit" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
            </StackPanel>
        </Border>

        <!-- Layer 4: Absolute Placement Canvas for Floating Toolbar and AI Panel -->
        <Canvas x:Name="FloatingCanvas">
            <!-- Floating Toolbar -->
            <overlay:FloatingToolbar x:Name="Toolbar" Visibility="Collapsed" />

            <!-- Floating Ask AI Card -->
            <ai:AskAiWindow x:Name="AiPanel" Visibility="Collapsed" />
        </Canvas>

        <!-- Layer 5: Toast Confirmation Notification -->
        <Border x:Name="ToastNotification"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,40"
                Background="#F0181B24"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,8"
                Visibility="Collapsed"
                Effect="{StaticResource ElevationShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ToastIcon" Text="✓" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" />
                <TextBlock x:Name="ToastMessage" Text="Copied to clipboard" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Medium" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
