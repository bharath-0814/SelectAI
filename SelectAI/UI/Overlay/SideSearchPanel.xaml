<UserControl x:Class="SelectAI.UI.Overlay.SideSearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#252A38" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown menu style for dark theme -->
        <Style x:Key="EngineContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#1A1C24" />
            <Setter Property="BorderBrush" Value="#2E3444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>
    </UserControl.Resources>

    <!-- Side Panel Dock Container matching Galaxy AI Select exactly -->
    <Border Background="#12141A"
            BorderBrush="#252A38"
            BorderThickness="1,0,0,0"
            Width="440"
            HorizontalAlignment="Right"
            Effect="{StaticResource ElevationShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Exact Galaxy AI Top Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: WebView2 Results Container in Dark Theme -->
                <RowDefinition Height="*" />
                <!-- Row 2: Footer Action Button -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Top Header matching Image 2 -->
            <Border Grid.Row="0" Background="#161820" BorderBrush="#222634" BorderThickness="0,0,0,1" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Back button -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Browser switcher icon + arrow -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Search capsule with thumbnail -->
                        <ColumnDefinition Width="*" />
                        <!-- Close button -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back Button ‹ -->
                    <Button x:Name="BtnBack"
                            Grid.Column="0"
                            Style="{StaticResource HeaderIconButton}"
                            Margin="0,0,4,0"
                            Click="OnBackClick"
                            ToolTip="Go back">
                        <TextBlock Text="‹" FontSize="22" FontWeight="Bold" Margin="0,-2,0,0" Foreground="#CBD5E1" />
                    </Button>

                    <!-- Browser Switcher Icon Button (with Down Arrow ▾) -->
                    <Button x:Name="BtnBrowserSelector"
                            Grid.Column="1"
                            Background="#222634"
                            BorderBrush="#31374A"
                            BorderThickness="1"
                            Height="34"
                            Padding="8,0"
                            Margin="0,0,6,0"
                            Cursor="Hand"
                            Click="OnBrowserSelectorClick"
                            ToolTip="Switch browser engine">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bb"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="17"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bb" Property="Background" Value="#2A3042" />
                                        <Setter TargetName="bb" Property="BorderBrush" Value="#0284C7" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Active Engine Icon -->
                            <TextBlock x:Name="TxtEngineIcon" Text="🔷" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="TxtEngineName" Text="Bing" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <!-- Down Arrow ▾ -->
                            <TextBlock Text="▾" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Context Menu for Browser Selection -->
                        <Button.ContextMenu>
                            <ContextMenu x:Name="BrowserContextMenu" Style="{StaticResource EngineContextMenu}">
                                <MenuItem Header="🔷 Bing Visual Search (Default)" Click="OnSelectBing" Foreground="#F8FAFC" />
                                <MenuItem Header="🌐 Google Lens &amp; Search" Click="OnSelectGoogle" Foreground="#F8FAFC" />
                                <MenuItem Header="🦁 Brave Browser" Click="OnSelectBrave" Foreground="#F8FAFC" />
                                <MenuItem Header="🦊 Mozilla Firefox" Click="OnSelectFirefox" Foreground="#F8FAFC" />
                                <MenuItem Header="🌊 Microsoft Edge" Click="OnSelectEdge" Foreground="#F8FAFC" />
                                <Separator Background="#2E3444" />
                                <MenuItem Header="➕ Add Custom Browser..." Click="OnAddCustomBrowser" Foreground="#38BDF8" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Search Capsule containing Thumbnail + Query + Search Icon -->
                    <Border Grid.Column="2"
                            Background="#222634"
                            BorderBrush="#31374A"
                            BorderThickness="1"
                            CornerRadius="17"
                            Height="34"
                            Padding="4,0,8,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- Cropped Thumbnail Preview -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Query Text Box -->
                                <ColumnDefinition Width="*" />
                                <!-- Search Icon -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Miniature Cropped Selection Thumbnail -->
                            <Border Grid.Column="0"
                                    Width="26" Height="26"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    Background="#0F172A"
                                    BorderBrush="#38BDF8"
                                    BorderThickness="1"
                                    Margin="0,0,6,0">
                                <Image x:Name="ImgSelectionThumbnail" Stretch="UniformToFill" />
                            </Border>

                            <!-- Search Input Box -->
                            <TextBox x:Name="TxtSearchQuery"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="#F8FAFC"
                                     BorderThickness="0"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     KeyDown="OnSearchBoxKeyDown" />

                            <!-- Search Magnifying Glass Button -->
                            <Button x:Name="BtnSearchQuery"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="OnSearchQueryClick"
                                    Margin="4,0,0,0">
                                <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Close Button ✕ -->
                    <Button x:Name="BtnClosePanel"
                            Grid.Column="3"
                            Style="{StaticResource HeaderIconButton}"
                            Margin="4,0,0,0"
                            Click="OnCloseClick"
                            ToolTip="Close panel (Esc)">
                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" />
                    </Button>
                </Grid>
            </Border>

            <!-- Row 1: Embedded Results with Force Dark Mode -->
            <Grid Grid.Row="1">
                <!-- WebView2 Browser Control -->
                <wv2:WebView2 x:Name="WebViewControl"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />

                <!-- Sleek Galaxy AI Loading Overlay -->
                <Border x:Name="LoadingOverlay"
                        Background="#E612141A"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <!-- Glowing AI Ring -->
                        <Border Width="60" Height="60"
                                CornerRadius="30"
                                BorderThickness="3"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00D4FF" Offset="0.0" />
                                    <GradientStop Color="#7C3AED" Offset="0.5" />
                                    <GradientStop Color="#10B981" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <TextBlock Text="✨" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Analyzing selection..."
                                   Foreground="#F8FAFC"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="Finding visual matches &amp; insights"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: Prominent Blue Pill Button matching Image 2 exactly -->
            <Border Grid.Row="2" Background="#161820" BorderBrush="#222634" BorderThickness="0,1,0,0" Padding="16,12">
                <Button x:Name="BtnShowInBrowser"
                        Height="42"
                        Cursor="Hand"
                        Click="OnShowInBrowserClick"
                        ToolTip="Open full results in external browser">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="#2563EB"
                                    CornerRadius="21"
                                    Effect="{StaticResource GlowShadow}"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Show results in browser"
                                               Foreground="#FFFFFF"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>
