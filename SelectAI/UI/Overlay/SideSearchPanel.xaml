<UserControl x:Class="SelectAI.UI.Overlay.SideSearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <Style x:Key="BrowserTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="#1E222D" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#2D3342"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#2A303F" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#0284C7" />
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#252A38" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Side Panel Dock Container -->
    <Border Background="#13151D"
            BorderBrush="#252A38"
            BorderThickness="1,0,0,0"
            Width="440"
            HorizontalAlignment="Right"
            Effect="{StaticResource ElevationShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header & Search Bar -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Browser Selection Pills -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: WebView / Results Container -->
                <RowDefinition Height="*" />
                <!-- Row 3: Footer Action Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Top Header with Search Bar -->
            <Border Grid.Row="0" Background="#181B24" BorderBrush="#262B3B" BorderThickness="0,0,0,1" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back Button -->
                    <Button x:Name="BtnBack"
                            Grid.Column="0"
                            Style="{StaticResource HeaderIconButton}"
                            Margin="0,0,6,0"
                            Click="OnBackClick"
                            ToolTip="Go back">
                        <TextBlock Text="‹" FontSize="22" FontWeight="Bold" Margin="0,-2,0,0" />
                    </Button>

                    <!-- Search Input Capsule -->
                    <Border Grid.Column="1"
                            Background="#222634"
                            BorderBrush="#31374A"
                            BorderThickness="1"
                            CornerRadius="18"
                            Height="36"
                            Padding="10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- AI Sparkle / Lens Icon -->
                            <TextBlock Grid.Column="0" Text="✨" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />

                            <!-- Search Input Box -->
                            <TextBox x:Name="TxtSearchQuery"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="#F8FAFC"
                                     BorderThickness="0"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     KeyDown="OnSearchBoxKeyDown" />

                            <!-- Search Icon Button -->
                            <Button x:Name="BtnSearchQuery"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="OnSearchQueryClick"
                                    Margin="4,0,0,0">
                                <TextBlock Text="🔍" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Close Button -->
                    <Button x:Name="BtnClosePanel"
                            Grid.Column="2"
                            Style="{StaticResource HeaderIconButton}"
                            Margin="6,0,0,0"
                            Click="OnCloseClick"
                            ToolTip="Close panel (Esc)">
                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold" />
                    </Button>
                </Grid>
            </Border>

            <!-- Row 1: Browser Selection Pills -->
            <Border Grid.Row="1" Background="#161822" BorderBrush="#222634" BorderThickness="0,0,0,1" Padding="12,6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BrowserPillsContainer" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Browser:" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <RadioButton x:Name="RbChrome" Content="Chrome" Style="{StaticResource BrowserTabButton}" IsChecked="True" Checked="OnBrowserChanged" />
                        <RadioButton x:Name="RbBrave" Content="Brave" Style="{StaticResource BrowserTabButton}" Checked="OnBrowserChanged" />
                        <RadioButton x:Name="RbFirefox" Content="Firefox" Style="{StaticResource BrowserTabButton}" Checked="OnBrowserChanged" />
                        <RadioButton x:Name="RbEdge" Content="Edge" Style="{StaticResource BrowserTabButton}" Checked="OnBrowserChanged" />
                        
                        <!-- Add Custom Browser Button -->
                        <Button x:Name="BtnAddBrowser"
                                Content="+ Add More"
                                Background="Transparent"
                                Foreground="#38BDF8"
                                BorderBrush="#0284C7"
                                BorderThickness="1"
                                Height="26"
                                Padding="8,2"
                                Margin="4,0,0,0"
                                Cursor="Hand"
                                FontSize="11"
                                Click="OnAddBrowserClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="13"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Row 2: WebView & Loading State -->
            <Grid Grid.Row="2">
                <!-- WebView2 Browser Control -->
                <wv2:WebView2 x:Name="WebViewControl"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />

                <!-- Sleek Galaxy AI Loading Overlay -->
                <Border x:Name="LoadingOverlay"
                        Background="#E613151D"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <!-- Glowing AI Ring -->
                        <Border Width="64" Height="64"
                                CornerRadius="32"
                                BorderThickness="3"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00D4FF" Offset="0.0" />
                                    <GradientStop Color="#7C3AED" Offset="0.5" />
                                    <GradientStop Color="#10B981" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <TextBlock Text="✨" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Analyzing with Gemini AI..."
                                   Foreground="#F8FAFC"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="Finding visual matches &amp; insights"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: Footer Prominent Blue Pill Button -->
            <Border Grid.Row="3" Background="#181B24" BorderBrush="#252A38" BorderThickness="0,1,0,0" Padding="16,12">
                <Button x:Name="BtnShowInBrowser"
                        Height="44"
                        Cursor="Hand"
                        Click="OnShowInBrowserClick"
                        ToolTip="Open full results in selected browser">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="#2563EB"
                                    CornerRadius="22"
                                    Effect="{StaticResource GlowShadow}"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Show results in browser"
                                               Foreground="#FFFFFF"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>
