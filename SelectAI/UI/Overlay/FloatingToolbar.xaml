<UserControl x:Class="SelectAI.UI.Overlay.FloatingToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid>
        <!-- Outer container with drop shadow -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="6"
                Effect="{StaticResource ElevationShadow}">
            <StackPanel Orientation="Vertical">

                <!-- Smart Actions Banner (Shown when URL/Email/Code detected) -->
                <Border x:Name="SmartActionBanner"
                        Visibility="Collapsed"
                        Background="#252F48"
                        BorderBrush="#0284C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        Margin="2,2,2,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SmartActionIcon" Text="🌐" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="SmartActionText" Text="Open Link" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="SmartActionButton" 
                                Content="Execute" 
                                Style="{StaticResource ToolbarPrimaryButton}"
                                Height="24"
                                Padding="8,2"
                                FontSize="11"
                                Click="OnSmartActionClick"/>
                    </StackPanel>
                </Border>

                <!-- Main Actions Row -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Ask AI Button (Primary Accent) -->
                    <Button x:Name="BtnAskAi"
                            Style="{StaticResource ToolbarPrimaryButton}"
                            Margin="2,0,4,0"
                            ToolTip="Ask AI to analyze, explain, or process selection"
                            Click="OnAskAiClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Sparkle Star Icon -->
                            <Path Data="M10,0 L12.5,7.5 L20,10 L12.5,12.5 L10,20 L7.5,12.5 L0,10 L7.5,7.5 Z"
                                  Fill="#0F172A"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Ask AI" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Google Search Button -->
                    <Button x:Name="BtnGoogleSearch"
                            Style="{StaticResource ToolbarActionButton}"
                            Margin="2,0"
                            ToolTip="Search selected text or image on Google"
                            Click="OnGoogleSearchClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Search Glass Icon -->
                            <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Search" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Google Lens Button -->
                    <Button x:Name="BtnGoogleLens"
                            Style="{StaticResource ToolbarActionButton}"
                            Margin="2,0"
                            ToolTip="Visual search with Google Lens"
                            Click="OnGoogleLensClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Camera / Lens Icon -->
                            <Path Data="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Lens" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Extract Text Button (OCR) -->
                    <Button x:Name="BtnExtractText"
                            Style="{StaticResource ToolbarActionButton}"
                            Margin="2,0"
                            ToolTip="Extract text using OCR and copy to clipboard"
                            Click="OnExtractTextClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Document / Text Icon -->
                            <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Extract Text" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Translate Button -->
                    <Button x:Name="BtnTranslate"
                            Style="{StaticResource ToolbarActionButton}"
                            Margin="2,0"
                            ToolTip="Translate selected text"
                            Click="OnTranslateClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Translate / Globe Icon -->
                            <Path Data="M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Translate" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="20" Fill="{StaticResource SurfaceBorderBrush}" Margin="4,0" />

                    <!-- Copy Button -->
                    <Button x:Name="BtnCopy"
                            Style="{StaticResource ToolbarActionButton}"
                            Margin="2,0"
                            ToolTip="Copy selection (Image or Text) to clipboard"
                            Click="OnCopyClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Clipboard Icon -->
                            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Copy" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Save Image Button -->
                    <Button x:Name="BtnSave"
                            Style="{StaticResource ToolbarActionButton}"
                            Margin="2,0"
                            ToolTip="Save selection as PNG file"
                            Click="OnSaveClick">
                        <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Width="14" Height="14"
                              Stretch="Uniform" />
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="BtnClose"
                            Style="{StaticResource ToolbarActionButton}"
                            Margin="2,0"
                            ToolTip="Cancel selection (Esc)"
                            Click="OnCloseClick">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Width="13" Height="13"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
